;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ITERATION 1 - PARTIE B
;; Humains et sorties individuelles de ravitaillement.
;; Utilise mourir [cause] de la partie A.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Variables propres a ce fichier ; clear-all les remet a 0.
globals [
  cases-sans-trajet        ;; cache de decider-sortie : cases de depart sans trajet rentable
  tick-cases-sans-trajet   ;;   au tick tick-cases-sans-trajet
  nb-sorties-terminees     ;; sorties revenues a la colonie
  nb-sorties-deficitaires  ;; sorties revenues avec un gain net <= 0 (doit rester a 0, invariant it1_C)
  gain-net-sorties         ;; somme des gains nets des sorties terminees
]

;; BILAN D'UNE SORTIE de n pas (rentabilite, voir sortie-rentable?) :
;;  - la colonie avance n + 1 unites au depart (ration-depart) ;
;;  - l'humain en consomme n a l'aller, arrive avec 1 unite et collecte q unites ;
;;  - il en consomme n au retour et depose 1 + q - n a la colonie.
;; Gain net pour la colonie = depot - avance = q - 2n. Une sortie n'est lancee que si la
;; quantite collectable est > 2n : chaque sortie terminee rapporte plus qu'elle ne consomme.

;; Quantite que l'humain pourra collecter sur ce point : le stock, dans la limite de la place
;; dans son sac a l'arrivee (capacite-transport - 1, car il arrive avec 1 unite).
;; Seul le stock non reserve par d'autres humains compte (reservation du stock, voir collecter).
to-report quantite-collectable [ point ]
  report min (list ([ stock-point - stock-reserve ] of point) (capacite-transport - 1))
end

;; RESERVATION DU STOCK. Au depart, l'humain reserve sur son point la quantite qu'il pourra
;; collecter (quantite-collectable) ; personne d'autre ne peut la prendre. A l'arrivee, il prend
;; sa reservation, plus ce qui n'est reserve par personne (regeneration), dans la limite de la
;; place dans son sac. La quantite collectee est donc toujours >= la reservation > 2n : chaque
;; sortie terminee rapporte plus qu'elle ne consomme, meme si d'autres humains visent le meme
;; point. S'il meurt ou se transforme en route, sa reservation est rendue (liberer-reservation).
to liberer-reservation
  if reservation > 0 and cible-point != nobody [
    let r reservation
    ask cible-point [ set stock-reserve stock-reserve - r ]
    set reservation 0
    ;; le stock libre augmente : le cache de decider-sortie n'est plus a jour pour ce tick
    set tick-cases-sans-trajet -1
  ]
end

;; Vrai si une sortie de nb-pas pas vers ce point rapporte plus qu'elle ne consomme.
to-report sortie-rentable? [ point nb-pas ]
  report quantite-collectable point > 2 * nb-pas
end

;; Repartir les humains entre les colonies et initialiser leurs variables.
to setup-humains
  let nombre-colonies count colonies
  if nombre-colonies = 0 [ stop ]

  let humains-par-colonie floor (nb-humains / nombre-colonies)
  let humains-restants (nb-humains - humains-par-colonie * nombre-colonies)

  foreach sort colonies [ colonie-actuelle ->
    let effectif humains-par-colonie

    ;; Distribuer le reste a raison d'un humain supplementaire par colonie.
    if humains-restants > 0 [
      set effectif effectif + 1
      set humains-restants humains-restants - 1
    ]

    ask colonie-actuelle [
      hatch-humains effectif [
        initialiser-humain colonie-actuelle

        ;; Placer l'humain sur une case vide voisine si possible.
        let cases-libres neighbors4 with [ type-patch = "vide" ]
        if any? cases-libres [
          move-to one-of cases-libres
        ]
      ]
    ]
  ]
end

;; Variables d'un humain qui nait dans la colonie maison (setup-humains et reproduire, it1_A).
;; Un humain cree par hatch copie les variables de la colonie (taille 2, couleur, etiquette) :
;; elles sont toutes redefinies ici.
;; Affichage : un humain present a la colonie est cache, l'etiquette de la colonie donne
;; l'effectif (actualiser-affichage-colonies, it1_A). Seuls les humains en sortie sont visibles :
;; la carte correspond ainsi exactement aux effectifs, meme a 25 humains par colonie.
to initialiser-humain [ maison ]
  set colonie-origine maison
  set etat "sain"
  set date-infection -1
  set nourriture-perso 0
  set mission "colonie"
  set cible-point nobody
  set chemin-aller []
  set groupe-id -1
  set reservation 0
  set shape "person"
  set color sky
  set size 1
  set label ""
  set hidden? true
end

;; Executer une seule action par tick selon la mission.
to humain-agir
  evoluer-infection

  (ifelse
    mission = "colonie" [ decider-sortie ]
    mission = "aller"   [ aller-vers-point ]
    mission = "retour"  [ rentrer-a-la-colonie ])
end

;; Verifier si la colonie a besoin de nourriture et peut financer une sortie.
to decider-sortie
  let origine colonie-origine
  let reserve [stock-colonie] of origine

  if reserve >= s-min [ stop ]

  ;; Plafond de 1 sortie simultanee par colonie, confirme.
  ;; C'est la valeur qui donne la meilleure survie. Cause des plafonds 2 et 4 mesuree : courses
  ;; aux points (une course perdue = un mort en route), puis avance de nourriture perdue qui
  ;; vide la colonie. A reexaminer a l'iteration 4 (groupes, departs simultanes).
  let plafond-sorties 1
  let sorties-en-cours count humains with [
    colonie-origine = origine and
    (mission = "aller" or mission = "retour")
  ]
  if sorties-en-cours >= plafond-sorties [ stop ]

  ;; Cache des cases sans trajet rentable pour le tick en cours. Tant qu'aucun point n'est
  ;; rentable, chaque humain present refaisait le meme parcours en largeur a chaque tick. Le
  ;; resultat ne depend que de la case de depart et des stocks des points ; pendant la phase des
  ;; humains, le stock libre (stock - reservations) ne fait que baisser (reservations, collecte) :
  ;; une case sans trajet le reste jusqu'au tick suivant. Seule exception, une reservation rendue
  ;; (liberer-reservation), qui vide le cache. Le cache ne change donc aucun resultat.
  if tick-cases-sans-trajet != ticks or not is-patch-set? cases-sans-trajet [
    set cases-sans-trajet no-patches
    set tick-cases-sans-trajet ticks
  ]
  if member? patch-here cases-sans-trajet [ stop ]

  let trajet chemin-vers-ravitaillement
  if empty? trajet [
    set cases-sans-trajet (patch-set cases-sans-trajet patch-here)
    stop
  ]

  ;; La liste inclut la case de depart : longueur = nombre de pas + 1.
  ;; Cette ration laisse une unite a l'arrivee. Regle a confirmer avec A.
  let ration-depart length trajet
  if ration-depart > reserve or ration-depart > capacite-transport [
    stop
  ]

  ask origine [
    set stock-colonie stock-colonie - ration-depart
  ]

  ;; Reserver sur le point la quantite qui rend la sortie rentable (voir liberer-reservation).
  let point last trajet
  let quantite-reservee quantite-collectable point
  ask point [ set stock-reserve stock-reserve + quantite-reservee ]
  set reservation quantite-reservee

  set nourriture-perso ration-depart
  set chemin-aller trajet
  set cible-point last trajet
  set mission "aller"
  set hidden? false   ;; visible pendant la sortie
end

;; Trouver le point approvisionne le plus proche en nombre de pas.
to-report chemin-vers-ravitaillement
  let depart patch-here
  let file-attente (list (list depart))
  let visites (patch-set depart)

  ;; La file contient les trajets a explorer, du plus court au plus long.
  while [not empty? file-attente] [
    let trajet first file-attente
    set file-attente but-first file-attente
    let case-actuelle last trajet

    ;; Une sortie doit etre rentable (voir le bilan en tete de fichier) : sinon on cherche un
    ;; point plus riche, meme plus loin. Le trajet inclut la case de depart : n = longueur - 1.
    ;; L'ancienne regle (stock > 2 x longueur) ignorait la capacite de transport : au-dela de
    ;; 24 pas, une sortie perdait de la nourriture meme sur un point plein.
    if [type-patch] of case-actuelle = "ravitaillement" and
       sortie-rentable? case-actuelle (length trajet - 1) [
      report trajet
    ]

    ;; Quatre voisines possibles : haut, bas, gauche et droite.
    let voisines [neighbors4] of case-actuelle
    let voisines-libres voisines with [
      type-patch != "obstacle" and not member? self visites
    ]

    foreach sort voisines-libres [ prochaine-case ->
      ;; Marquer la case des son ajout pour eviter de l'explorer deux fois.
      set visites (patch-set visites prochaine-case)
      set file-attente lput (lput prochaine-case trajet) file-attente
    ]
  ]

  report []
end

;; Avancer d'une case et consommer une unite par pas.
;; CONSOMMATION 2 SUR 2 (critere 6) : la consommation en deplacement. A chaque tick de marche,
;; a l'aller comme au retour, l'humain consomme 1 unite de sa nourriture transportee
;; (nourriture-perso), avancee par la colonie au depart (ration-depart). A 0 en route, il meurt
;; de famine. Elle est distincte de la consommation quotidienne de la colonie (it1_A,
;; evenements-journaliers).
to aller-vers-point
  if patch-here = cible-point [
    collecter
    stop
  ]

  let indice position patch-here chemin-aller
  let prochaine-case item (indice + 1) chemin-aller
  move-to prochaine-case
  set nourriture-perso nourriture-perso - 1

  if nourriture-perso <= 0 [
    mourir "famine"
    stop
  ]

  if patch-here = cible-point [
    collecter
  ]
end

;; Prendre la quantite disponible dans la limite de la place restante.
to collecter
  ;; Reservation du stock (voir liberer-reservation) : l'humain peut prendre tout le stock sauf
  ;; ce que les autres humains ont reserve, donc au moins sa propre reservation.
  let place-disponible max (list 0 (capacite-transport - nourriture-perso))
  let reserve-des-autres [ stock-reserve ] of cible-point - reservation
  let quantite min (list ([ stock-point ] of cible-point - reserve-des-autres) place-disponible)
  let ma-reservation reservation

  ask cible-point [
    set stock-point stock-point - quantite
    set stock-reserve stock-reserve - ma-reservation
  ]
  set reservation 0

  set nourriture-perso nourriture-perso + quantite
  set mission "retour"
end

;; Suivre le meme trajet en sens inverse et deposer le reliquat.
to rentrer-a-la-colonie
  let indice position patch-here chemin-aller

  if indice > 0 [
    let prochaine-case item (indice - 1) chemin-aller
    move-to prochaine-case
    set nourriture-perso nourriture-perso - 1

    if nourriture-perso <= 0 [
      mourir "famine"
      stop
    ]
  ]

  ;; La premiere case du trajet est la case de depart de l'humain.
  if patch-here = first chemin-aller [
    let nourriture-rapportee nourriture-perso

    ask colonie-origine [
      set stock-colonie stock-colonie + nourriture-rapportee
    ]

    ;; Bilan de la sortie : depot - avance de depart (= longueur du trajet).
    let gain-net nourriture-rapportee - length chemin-aller
    set nb-sorties-terminees nb-sorties-terminees + 1
    set gain-net-sorties gain-net-sorties + gain-net
    if gain-net <= 0 [ set nb-sorties-deficitaires nb-sorties-deficitaires + 1 ]

    ;; Reinitialiser les variables de sortie pour la prochaine mission.
    set nourriture-perso 0
    set chemin-aller []
    set cible-point nobody
    set mission "colonie"
    set hidden? true    ;; de retour : compte dans l'etiquette de la colonie
  ]
end