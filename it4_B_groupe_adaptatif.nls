;; Rayon autour de la colonie dans lequel les zombies sont reperes (en patches). A regler et a
;; justifier (par exemple portee-detection, ou la distance d'une sortie typique).
to-report rayon-reperage
  ;; TODO
  report portee-detection
end

;; Zombies reperes autour de la colonie c. Attention : les zombies n'attaquent pas dans la colonie
;; (proies-visibles, it2_A), c'est un indice de danger pour la sortie, pas pour la colonie.
to-report zombies-reperes [ c ]
  ;; TODO : [ count zombies in-radius rayon-reperage ] of c
  report 0
end

;; Taille du groupe pour la colonie c : par exemple 1 sans zombie repere, puis une taille qui croit
;; avec le nombre de zombies, bornee par taille-groupe (curseur) et par les humains disponibles.
;; La regle et ses seuils sont a choisir, a mesurer (100 graines par variante) et a justifier.
to-report taille-groupe-adaptative [ c ]
  ;; TODO
  report taille-groupe
end
