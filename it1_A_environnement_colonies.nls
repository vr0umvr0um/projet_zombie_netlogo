;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ITERATION 1 - PARTIE A : environnement et colonies
;; Responsable : Soumia
;; Carte, obstacles, points de ravitaillement, colonies, consommation, famine, reproduction, mort.
;; Test : nb-zombies = 0. Fournit mourir [cause] aux autres parties.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup-environnement
  ;; Initialiser les cases de la carte
  ask patches [
    set type-patch "vide"
    set stock-point 0
    set stock-max-point 0
    set pcolor brown
  ]

  ;; Placer les obstacles au hasard
  ask n-of nb-obstacles patches [
    set type-patch "obstacle"
    set pcolor gray
  ]

  ;; Placer les points de ravitaillement hors des obstacles
  ask n-of nb-points-ravitaillement patches with [type-patch = "vide"] [
    set type-patch "ravitaillement"
    set stock-point stock-initial-point
    set stock-max-point stock-initial-point
    set pcolor green
  ]
end

to setup-colonies
  let numero 0

  repeat nb-colonies [
    ;; Choisir une case libre, assez loin des autres colonies
    let emplacement one-of patches with [
      type-patch = "vide"
      and not any? colonies in-radius 6
      and not any? (patches in-radius 3) with [
        type-patch = "ravitaillement"
      ]
    ]

    if emplacement = nobody [
      error "Pas assez de place pour installer les colonies."
    ]

    create-colonies 1 [
      move-to emplacement
      set id-colonie numero
      set stock-colonie stock-initial-colonie
      set shape "house"
      set color blue
      set size 2
    ]

    set numero numero + 1
  ]
end


to regenerer-points
  ask patches with [type-patch = "ravitaillement"] [
    set stock-point stock-point + regeneration-point

    if stock-point > stock-max-point [
      set stock-point stock-max-point
    ]

    ;; Borne haute a 2 x le stock maximal : scale-color donne du blanc a la borne haute, un point
    ;; plein restait donc blanc. Ici, plein = vert franc, vide = noir.
    ifelse stock-max-point > 0 [
      set pcolor scale-color green stock-point 0 (2 * stock-max-point)
    ] [
      set pcolor black
    ]
  ]
end

;; CONSOMMATION 1 SUR 2 (critere 6) : la consommation quotidienne. Une fois par jour (toutes
;; les 24 ticks), chaque humain present a la colonie (mission = "colonie") consomme
;; consommation-jour unites du stock de sa colonie. Les humains en sortie ne consomment rien
;; ici : ils consomment la nourriture qu'ils transportent (voir it1_B, aller-vers-point).
;;
;; Regle de famine inchangee. Chaque humain present non
;; nourri meurt le jour meme ; quand le stock d'une colonie tombe a zero, tous ses habitants
;; restants meurent donc ensemble. Un delai de grace n'est a envisager que si le critere 4
;; de l'iteration 1 resiste avec les reglages actuels.
to evenements-journaliers
  ask colonies [
    let maison self

    let habitants humains with [
      colonie-origine = maison and mission = "colonie"
    ]

    ask habitants [
      ifelse [stock-colonie] of maison >= consommation-jour [
        ask maison [
          set stock-colonie stock-colonie - consommation-jour
        ]
      ] [
        mourir "famine"
      ]
    ]
  ]

  reproduire
end

to reproduire
  ask colonies [
    let maison self
    let habitants humains with [colonie-origine = maison]

    if any? habitants [
      if stock-colonie > seuil-naissance [
        if random-float 1 < taux-naissance [
          hatch-humains 1 [
            initialiser-humain maison   ;; it1_B
          ]

          set nb-naissances nb-naissances + 1
        ]
      ]
    ]
  ]
end


;; Etiquette et couleur des colonies, appelee a la fin de setup et de chaque tick (fichier principal).
;; Les humains presents a la colonie sont caches (it1_B, initialiser-humain) : l'etiquette donne
;; leur nombre total (presents et en sortie), les infectes et le stock. La couleur suit le stock :
;; bleu si le stock atteint s-min, bleu fonce en dessous (sorties en cours), noir a zero (famine),
;; gris sans habitant.
;; foreach sort et ask sur un seul agent : pas de tirage aleatoire, les resultats ne changent pas.
to actualiser-affichage-colonies
  foreach sort colonies [ c ->
    ask c [
      let habitants humains with [ colonie-origine = myself ]
      let infectes count habitants with [ etat = "infecte" ]
      set label (word count habitants " h"
                      ifelse-value (infectes > 0) [ (word " (" infectes " inf.)") ] [ "" ]
                      " / " round stock-colonie)
      set color (ifelse-value
        not any? habitants   [ gray ]
        stock-colonie >= s-min [ blue ]
        stock-colonie > 0      [ blue - 3 ]
                               [ black ])
    ]
  ]
end

to mourir [ cause ]
  if cause = "infection" [
    set nb-morts-infection nb-morts-infection + 1
  ]

  if cause = "attaque" [
    set nb-morts-attaque nb-morts-attaque + 1
  ]

  if cause = "famine" [
    set nb-morts-famine nb-morts-famine + 1
  ]

  die
end

