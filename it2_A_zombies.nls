;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ITERATION 2 - PARTIE A : zombies (cote zombie)
;; Responsable : Soumia
;; Creation, errance, poursuite, attaque au contact. Test : nb-zombies = 20, nb-obstacles = 0.
;; La colonie protege ses habitants : un zombie ne voit et n'attaque que les humains en sortie
;; (proies-visibles), comme le prevoit le TP5 (defense "pendant le deplacement de l'humain").
;; Inspirations : Zombieland (Ball), The Walking Dead ABM (Buyukkinaci), Wolf Sheep Predation (Wilensky),
;; Predator Prey Game HubNet.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Zones de depart : ni obstacle, ni a moins de 4 patchs d'une colonie
to setup-zombies  
  let candidats patches with [ type-patch != "obstacle" and not any? colonies in-radius 4 ]
  if not any? candidats [ set candidats patches with [ type-patch != "obstacle" ] ]

  create-zombies nb-zombies [
    initialiser-zombie
    move-to one-of candidats
  ]
  ;; nb-zombies-initial est affecte dans setup (fichier principal), apres setup-zombies
end

;; Parametres communs a un zombie, utilises par setup-zombies et transformer
;; Un zombie issu d'un humain (transformer, hatch) copie ses variables : un humain present a la
;; colonie est cache, d'ou hidden? false. Meme taille que les humains, seule la couleur change.
to initialiser-zombie
  set age-zombie 0
  set shape "person"
  set color violet
  set size 1
  set label ""
  set hidden? false
end

to zombie-agir
  set age-zombie age-zombie + 1
  ifelse age-zombie > duree-vie-zombie [
    set nb-zombies-vieux nb-zombies-vieux + 1
    die
  ] [
    ;; priorite : attaquer au contact (meme sans poursuite), puis poursuivre, puis errer
    (ifelse
      any? proies-visibles distance-contact  [ zombie-attaquer ]
      any? proies-visibles portee-detection  [ zombie-poursuivre ]
      [ zombie-errer ])
  ]
end

;; Marche aleatoire a petits virages (comme Zombieland), sans entrer dans un obstacle
to zombie-errer
  rt random-float 30
  lt random-float 30
  avancer-zombie
end

;; Se rapproche de l'humain le plus proche dans son rayon de detection
to zombie-poursuivre
  let cible min-one-of proies-visibles portee-detection [ distance myself ]
  face cible
  avancer-zombie
end

;; Attaque un humain tire au hasard parmi ceux au contact (one-of, comme Wolf Sheep Predation).
;; Sans proie visible au contact (humain a la colonie), il ne se passe rien.
to zombie-attaquer
  let cible one-of proies-visibles distance-contact
  let attaquant self
  if cible != nobody [ ask cible [ detecter-et-defendre attaquant ] ]
end

;; Humains qu'un zombie peut voir et attaquer dans ce rayon : seulement ceux en sortie
;; (mission "aller" ou "retour"). Les humains a la colonie (mission "colonie", caches) sont a
;; l'abri : sans cette regle, 99 % des attaques visaient des humains dans leur colonie (mesure sur
;; 100 graines) et la strategie de ravitaillement n'avait presque plus d'effet sur le risque.
;; Un infecte qui rentre peut encore se transformer a la colonie : le zombie apparait sur place,
;; puis ne s'en prend qu'aux humains qui sortent.
to-report proies-visibles [ rayon ]
  report (humains in-radius rayon) with [ mission != "colonie" ]
end

;; Predation (appelee par detecter-et-defendre, it2_B, quand l'humain attaque est tue) : comme le
;; loup de Wolf Sheep Predation qui gagne de l'energie en mangeant, le zombie gagne
;; gain-attaque-zombie ticks de vie (son age recule, sans descendre sous 0).
;; Le zombie vit donc plus longtemps quand les proies sont nombreuses : c'est le couplage
;; proie-predateur qui manquait (avant, la duree de vie ne dependait pas des humains).
to zombie-se-nourrir
  set age-zombie max (list 0 (age-zombie - gain-attaque-zombie))
end

;; Avance d'un pas si la case devant est franchissable, sinon demi-tour approximatif
to avancer-zombie
  ifelse case-franchissable? patch-ahead vitesse-zombie
    [ fd vitesse-zombie ]
    [ rt 150 + random 60 ]
end

;; Parametres fixes du zombie, regroupes ici pour etre modifies (ou mis en slider) au meme endroit
to-report vitesse-zombie     ;; patchs par tick (un humain fait 1 patch par tick)
  report 0.5
end

to-report distance-contact   ;; distance d'attaque, en patchs
  report 1
end

;; Vrai si le patch existe (pas de bord de carte) et n'est pas un obstacle
to-report case-franchissable? [ p ]
  report p != nobody and [ type-patch ] of p != "obstacle"
end
